{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annonce BOAMP (enveloppe d'événement)",
  "type": "object",
  "required": ["source", "event_id", "timestamp", "ingested_at", "schema_version", "payload"],
  "properties": {
    "source": {"enum": ["api-boamp", "boamp-fichiers"]},
    "event_id": {"type": "string", "pattern": "^boamp-[0-9]{2}-[0-9]+$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "ingested_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"},
    "schema_version": {"const": "1.0"},
    "payload": {
      "type": "object",
      "required": ["idweb", "objet", "nomacheteur", "dateparution", "datelimitereponse",
                   "code_departement", "nature_libelle", "famille_libelle", "type_marche",
                   "procedure_libelle", "titulaire", "descripteur_libelle", "url_avis"],
      "properties": {
        "idweb": {"type": "string", "pattern": "^[0-9]{2}-[0-9]+$"},
        "objet": {"type": "string", "minLength": 1},
        "nomacheteur": {"type": "string", "minLength": 1},
        "dateparution": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "datelimitereponse": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
        },
        "code_departement": {
          "type": ["array", "null"],
          "items": {"type": "string", "pattern": "^([0-9]{1,3}|2[AB]|20[AB])$"}
        },
        "nature_libelle": {"type": "string", "minLength": 1},
        "famille_libelle": {"type": "string"},
        "type_marche": {
          "type": ["array", "null"],
          "items": {"enum": ["SERVICES", "FOURNITURES", "TRAVAUX"]}
        },
        "procedure_libelle": {"type": "string"},
        "titulaire": {"type": ["array", "null"], "items": {"type": "string"}},
        "descripteur_libelle": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "url_avis": {"type": "string", "pattern": "^https://www\\.boamp\\.fr/"}
      }
    }
  }
}